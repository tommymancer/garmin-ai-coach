# ---- Garmin Connect ----
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# ---- Telegram ----
# Create a bot with @BotFather, paste the token here.
TELEGRAM_BOT_TOKEN=123456789:AA...
# Your numeric Telegram user ID (message the bot, then run: python -m tools.whoami)
# Comma-separate to allow several people.
TELEGRAM_CHAT_ID=123456789

# ---- Claude API ----
# https://console.anthropic.com  →  API keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Optional tuning ----
# claude-sonnet-5 (default, best value) | claude-opus-4-8 (highest quality) | claude-haiku-4-5 (cheapest)
COACH_MODEL=claude-sonnet-5
# low | medium | high  — how much the model reasons before answering
COACH_EFFORT=medium
# Language the coach writes in (any language name works)
COACH_LANGUAGE=English
# Where state, profile, plan and tokens are stored
# COACH_DATA_DIR=~/.garmin-ai-coach
# Seconds to cache Garmin data in the chat daemon
# COACH_SNAPSHOT_TTL=600
